#!/usr/bin/env bash
# Pre-commit hook: run RuboCop on staged Ruby files.
# Reject the commit if any offenses are found.
#
# Installed automatically by bin/setup via:
#   git config core.hooksPath .githooks

set -euo pipefail

STAGED_RB=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rb$' || true)

if [ -z "$STAGED_RB" ]; then
  exit 0
fi

echo "RuboCop: checking staged Ruby files..."

# shellcheck disable=SC2086
bundle exec rubocop --no-color --format simple $STAGED_RB
