# ======================================
# Weather API Keys
# ======================================

# OpenWeatherMap API Key (Required)
# Get your free API key at: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# National Weather Service User Agent (Future - Optional)
# Format: AppName/Version (contact@email.com)
# NWS_USER_AGENT=WeatherForecast/1.0 (your@email.com)

# ======================================
# Redis Configuration
# ======================================

# Redis connection URL
# Default: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# TTL - Time-To-Live - expressed in whole seconds
REDIS_TTL_FORECAST=1800 # 30 minutes
REDIS_TTL_CURRENT=900   # 15 minutes

# ======================================
# Rails Configuration
# ======================================

# Rails environment (development, test, production)
RAILS_ENV=development

# Rails secret key base
# Generate with: rails secret
SECRET_KEY_BASE=generate_with_rails_secret_command

# ======================================
# Production Settings (Optional)
# ======================================

# Serve static files in production (uncomment if needed)
# RAILS_SERVE_STATIC_FILES=true

# Log to STDOUT in production (uncomment if needed)
# RAILS_LOG_TO_STDOUT=true

# ======================================
# Development Settings (Optional)
# ======================================

# Rails server port (default: 3000)
# PORT=3000

# Rails server binding (default: localhost)
# BINDING=localhost

# ======================================
# Security Settings (Optional)
# ======================================

# CORS — comma-separated allowed origins; leave unset to allow all origins
# CORS_ALLOWED_ORIGINS=https://myapp.com,https://app.myapp.com

# API key authentication — comma-separated keys; leave unset to run open (dev mode)
# Generate a key with: bundle exec rake api_keys:generate
# API_KEYS=your_api_key_here

# Rate limiting (per IP)
# RATE_LIMIT_API_RPM=60     # requests per minute (default: 60)
# RATE_LIMIT_BURST_RPS=10   # requests per 10 seconds (default: 10)

# ======================================
# HTTP Client Settings (Optional)
# ======================================

# Timeout for opening a connection to the weather API (seconds)
# HTTP_OPEN_TIMEOUT=5

# Timeout for reading a response from the weather API (seconds)
# HTTP_READ_TIMEOUT=10
